<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ only: Theme.BitChord plus the system splash branding —
      SONARA's violet-black ground (#0D0A14, the dark theme's background) and
      the launcher foreground mark. A values-v31 style replaces rather than
      merges with the values one, so the parent and windowBackground repeat
      from values/themes.xml; keep the two in step.
    -->
    <style name="Theme.BitChord" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">#0D0A14</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
